{
  "buildCommand": "cd website && npm install && npm run build && mkdir -p .next/public && cp -r public/. .next/public/",
  "outputDirectory": "website/.next",
  "rewrites": [
    { "source": "/download/apk", "destination": "/public/download/apk.apk" },
    { "source": "/treino", "destination": "/public/public/treino/index.html" },
    { "source": "/treino/(.*)", "destination": "/public/public/treino/$1" }
  ],
  "headers": [
    {
      "source": "/public/download/apk.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=buildfit.apk" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    },
    {
      "source": "/public/public/treino/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}