{
  "buildCommand": "cd website && npm install && npm run build && cd .. && mkdir -p dist && cp -r website/.next/. ./dist/ && cp -r website/public/. ./dist/ && cp -r api/. ./dist/api/",
  "outputDirectory": "dist",
  "framework": "nextjs",
  "rewrites": [
    { "source": "/download/apk", "destination": "/download/apk.apk" },
    { "source": "/treino", "destination": "/treino/index.html" },
    { "source": "/treino/", "destination": "/treino/index.html" },
    { "source": "/treino/:path((?!.*\\.).*)", "destination": "/treino/index.html" },
    { "source": "/treino/(.*)", "destination": "/treino/$1" },
    { "source": "/api/gif", "destination": "/api/gif.js" }
  ],
  "headers": [
    {
      "source": "/download/apk.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=buildfit.apk" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    },
    {
      "source": "/treino/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}