{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/download/apk", "destination": "/download/apk.apk" }
  ],
  "headers": [
    {
      "source": "/download/apk.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=buildfit.apk" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    },
    {
      "source": "/treino/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}