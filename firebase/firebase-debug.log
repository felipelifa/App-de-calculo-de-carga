[debug] [2026-04-01T20:47:34.254Z] >>> [apiv2][query] PUT http://127.0.0.1:8080/emulator/v1/projects/appcalculotreino-51f23:securityRules [none]
[debug] [2026-04-01T20:47:34.254Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/appcalculotreino-51f23:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return isAuthenticated() && request.auth.uid == uid;\n    }\n\n    function isValidString(field, maxLen) {\n      return field is string && field.size() > 0 && field.size() <= maxLen;\n    }\n\n    function isValidNumber(field, minVal, maxVal) {\n      return field is number && field >= minVal && field <= maxVal;\n    }\n\n    // ────────────────────────────────────────────────────────────\n    // users/{uid}  →  profile document\n    // ────────────────────────────────────────────────────────────\n    match /users/{uid} {\n      allow read: if isOwner(uid);\n      allow create: if isOwner(uid)\n        && isValidString(request.resource.data.name, 100)\n        && isValidString(request.resource.data.email, 255);\n      allow update: if isOwner(uid)\n        && isValidString(request.resource.data.name, 100);\n      allow delete: if false; // soft-delete only via Cloud Functions\n\n      // ──────────────────────────────────────────────────────────\n      // users/{uid}/exercises/{exId}\n      // ──────────────────────────────────────────────────────────\n      match /exercises/{exId} {\n        allow read: if isOwner(uid);\n        allow create: if isOwner(uid)\n          && isValidString(request.resource.data.name, 100)\n          && isValidNumber(request.resource.data.seriesDefault, 1, 20)\n          && isValidNumber(request.resource.data.repMin, 1, 30)\n          && isValidNumber(request.resource.data.repMax, 1, 30)\n          && request.resource.data.repMin <= request.resource.data.repMax;\n        allow update: if isOwner(uid)\n          && isValidString(request.resource.data.name, 100)\n          && isValidNumber(request.resource.data.seriesDefault, 1, 20)\n          && isValidNumber(request.resource.data.repMin, 1, 30)\n          && isValidNumber(request.resource.data.repMax, 1, 30);\n        allow delete: if isOwner(uid);\n      }\n\n      // ──────────────────────────────────────────────────────────\n      // users/{uid}/workouts/{wId}\n      // ──────────────────────────────────────────────────────────\n      match /workouts/{wId} {\n        allow read: if isOwner(uid);\n        allow create: if isOwner(uid)\n          && isValidNumber(request.resource.data.weekNumber, 1, 9999)\n          && request.resource.data.date is timestamp;\n        allow update: if isOwner(uid);\n        allow delete: if isOwner(uid);\n\n        // users/{uid}/workouts/{wId}/exercises/{weId}\n        match /exercises/{weId} {\n          allow read: if isOwner(uid);\n          allow create: if isOwner(uid)\n            && isValidNumber(request.resource.data.series, 1, 20)\n            && isValidNumber(request.resource.data.reps, 1, 30)\n            && isValidNumber(request.resource.data.weight, 0.5, 1000)\n            && isValidNumber(request.resource.data.volume, 0, 500000);\n          allow update: if isOwner(uid);\n          allow delete: if isOwner(uid);\n        }\n      }\n\n      // ──────────────────────────────────────────────────────────\n      // users/{uid}/progressionWeeks/{pwId}\n      // ──────────────────────────────────────────────────────────\n      match /progressionWeeks/{pwId} {\n        allow read: if isOwner(uid);\n        allow create: if isOwner(uid)\n          && isValidNumber(request.resource.data.weekNumber, 1, 9999)\n          && isValidNumber(request.resource.data.progressionPercent, -50, 50)\n          && request.resource.data.type in ['base', 'progression', 'deload'];\n        allow update: if isOwner(uid);\n        allow delete: if isOwner(uid);\n      }\n\n      // ──────────────────────────────────────────────────────────\n      // users/{uid}/volumeHistory/{vhId}\n      // Written ONLY by Cloud Functions (backend validation)\n      // ──────────────────────────────────────────────────────────\n      match /volumeHistory/{vhId} {\n        allow read: if isOwner(uid);\n        allow write: if false; // Cloud Functions only\n      }\n\n      // ──────────────────────────────────────────────────────────\n      // users/{uid}/suggestedProgressions/{spId}\n      // Written ONLY by Cloud Functions\n      // ──────────────────────────────────────────────────────────\n      match /suggestedProgressions/{spId} {\n        allow read: if isOwner(uid);\n        allow write: if false; // Cloud Functions only\n      }\n\n      // ──────────────────────────────────────────────────────────\n      // users/{uid}/profile/{docId}\n      // ──────────────────────────────────────────────────────────\n      match /profile/{docId} {\n        allow read, write: if isOwner(uid);\n      }\n\n      // ──────────────────────────────────────────────────────────\n      // users/{uid}/generated_workouts/{docId}\n      // ──────────────────────────────────────────────────────────\n      match /generated_workouts/{docId} {\n        allow read, write: if isOwner(uid);\n      }\n    }\n\n    // ────────────────────────────────────────────────────────────\n    // config  →  global app config (APK version, etc.)\n    // Read-only for authenticated users, write only by admin SDK\n    // ────────────────────────────────────────────────────────────\n    match /config/{docId} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Admin SDK via Cloud Functions only\n    }\n\n    // ────────────────────────────────────────────────────────────\n    // exercises  →  global exercise library\n    // Read-only for authenticated users, write only by admin SDK\n    // ────────────────────────────────────────────────────────────\n    match /exercises/{exId} {\n      allow read: if isAuthenticated();\n      allow write: if false; \n    }\n\n    // Block everything else\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n"}]}}
