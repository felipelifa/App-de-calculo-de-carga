rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidString(field, maxLen) {
      return field is string && field.size() > 0 && field.size() <= maxLen;
    }

    function isValidNumber(field, minVal, maxVal) {
      return field is number && field >= minVal && field <= maxVal;
    }

    // ── users/{uid} ──────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidString(request.resource.data.name, 100)
        && isValidString(request.resource.data.email, 255);
      allow update: if isOwner(uid)
        && isValidString(request.resource.data.name, 100);
      allow delete: if false;

      // exercises
      match /exercises/{exId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidString(request.resource.data.name, 100)
          && isValidNumber(request.resource.data.seriesDefault, 1, 20)
          && isValidNumber(request.resource.data.repMin, 1, 30)
          && isValidNumber(request.resource.data.repMax, 1, 30)
          && request.resource.data.repMin <= request.resource.data.repMax;
        allow update: if isOwner(uid)
          && isValidString(request.resource.data.name, 100)
          && isValidNumber(request.resource.data.seriesDefault, 1, 20)
          && isValidNumber(request.resource.data.repMin, 1, 30)
          && isValidNumber(request.resource.data.repMax, 1, 30);
        allow delete: if isOwner(uid);
      }

      // workouts
      match /workouts/{wId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidNumber(request.resource.data.weekNumber, 1, 9999)
          && request.resource.data.date is timestamp;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);

        match /exercises/{weId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && isValidNumber(request.resource.data.series, 1, 20)
            && isValidNumber(request.resource.data.reps, 1, 30)
            && isValidNumber(request.resource.data.weight, 0.5, 1000)
            && isValidNumber(request.resource.data.volume, 0, 500000);
          allow update: if isOwner(uid);
          allow delete: if isOwner(uid);
        }
      }

      // progressionWeeks
      match /progressionWeeks/{pwId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidNumber(request.resource.data.weekNumber, 1, 9999)
          && isValidNumber(request.resource.data.progressionPercent, -50, 50)
          && request.resource.data.type in ['base', 'progression', 'deload'];
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid);
      }

      // volumeHistory — Cloud Functions only
      match /volumeHistory/{vhId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // suggestedProgressions — Cloud Functions only
      match /suggestedProgressions/{spId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // profile
      match /profile/{docId} {
        allow read, write: if isOwner(uid);
      }

      // generated_workouts
      match /generated_workouts/{docId} {
        allow read, write: if isOwner(uid);
      }

      // progression_state — motor de progressão
      match /progression_state/{docId} {
        allow read, write: if isOwner(uid);
      }

      // personalRecords
      match /personalRecords/{exId} {
        allow read, write: if isOwner(uid);
      }

      // nutrition
      match /nutrition/{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── global foods library — read-only for authenticated ───────
    match /foods/{foodId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── proTokens — apenas leitura, resgate é via Cloud Function ─
    match /proTokens/{code} {
      allow read: if isAuthenticated();
      allow write: if false; // apenas Cloud Functions escreve
    }

    // ── config — read-only para autenticados ─────────────────────
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ── exercises — biblioteca global, read-only ─────────────────
    match /exercises/{exId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Bloqueia tudo mais
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
