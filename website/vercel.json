{
  "buildCommand": "cd website && npm install && npm run build",
  "outputDirectory": "website/.next/standalone",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/download/apk", "destination": "/download/apk.apk" }
  ],
  "headers": [
    {
      "source": "/download/apk.apk",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=controle-de-carga.apk" },
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" }
      ]
    }
  ]
}
